# พอร์ตที่รัน (ค่าเริ่มต้น 3000)
PORT=3000

# โฟลเดอร์เก็บฐานข้อมูล + รูปเอกสาร (ค่าเริ่มต้น ./data)
DATA_DIR=./data

# ---- ตัวเลือกเสริม (ไม่ใส่ก็ใช้งานได้ปกติ) ----

# แจ้งเตือนเข้า Slack เมื่อรับเอกสาร / ส่งมอบ / บัญชีรับแล้ว
# สร้างที่ Slack → Apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# อ่านข้อมูลจากรูปเอกสารอัตโนมัติ (ป๊อปไม่ต้องพิมพ์เอง)
# ขอ key ที่ https://console.anthropic.com
ANTHROPIC_API_KEY=
